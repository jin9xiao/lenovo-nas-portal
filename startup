#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
base=/media/nas-portal
run=/run/nas-portal
nginx=/usr/sbin/nginx
umask 022

running() {
    [ -r "$1" ] || return 1
    pid=$(cat "$1")
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ] && [ -r "/proc/$pid/cmdline" ] &&
        tr '\000' ' ' < "/proc/$pid/cmdline" | grep -Fq "$2"
}

case "${1:-start}" in
    start)
        [ -r "$base/server.py" ] || exit 1
        [ -r "$base/settings.json" ] || exit 1
        mkdir -p "$run"
        exec 9>"$run/start.lock"
        flock -n 9 || exit 0
        if ! running "$run/nginx.pid" "$base/nginx.conf"; then
            "$nginx" -t -c "$base/nginx.conf"
            "$nginx" -c "$base/nginx.conf" 9>&-
        fi
        if ! running "$run/status.pid" "$base/server.py"; then
            nohup /usr/bin/python -B "$base/server.py" </dev/null >>"$run/status.log" 2>&1 9>&- &
            echo "$!" >"$run/status.pid"
        fi
        ;;
    stop)
        if running "$run/nginx.pid" "$base/nginx.conf"; then
            "$nginx" -c "$base/nginx.conf" -s quit
        fi
        if running "$run/status.pid" "$base/server.py"; then
            kill "$(cat "$run/status.pid")"
        fi
        ;;
    *) exit 2 ;;
esac
